APP_PORT=5002
# Keep the new SQLite/files root separate from the old data/postgres directory.
DATA_DIR_HOST=./data/single-host

# Direct Compose use: create writable directories for this UID/GID first.
# scripts/start_local.sh defaults these to your current user.
APP_UID=10001
APP_GID=10001

# Host library mounted at /komga; save /komga in the application's settings.
# Saved settings override this optional initial directory default.
# KOMGA_DIR=/komga
# KOMGA_DIR_HOST=/absolute/path/to/komga/library

# Pin an immutable sha-<full-commit-sha> tag for production and rollback.
# TELEGRAPH_IMAGE=ghcr.io/srcheng17/telegram_downloader:sha-<full-commit-sha>
