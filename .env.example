APP_ENV=development
APP_PORT=5002
# Remote access requires your HTTPS public origin. HTTP is only allowed for
# explicit loopback development; the gateway binds to loopback by default.
APP_BIND_ADDRESS=127.0.0.1
APP_PUBLIC_ORIGIN=http://127.0.0.1:5002
ALLOW_INSECURE_LOOPBACK=true
APP_UID=10001
APP_GID=10001

# Create these files before startup, owned by APP_UID with mode 0400 or 0600.
# Bootstrap password: at least 12 characters, at most 72 UTF-8 bytes; no default.
# Master key: base64 of 32 random bytes. Back it up separately from PostgreSQL.
ADMIN_BOOTSTRAP_PASSWORD_FILE_HOST=./secrets/admin-bootstrap-password
SOURCE_SETTINGS_MASTER_KEY_FILE_HOST=./secrets/source-settings-master-key

POSTGRES_DB=telegraph
POSTGRES_USER=telegraph
POSTGRES_PASSWORD=telegraph

GO_WORKER_CONSUMER_NAME=

INTERNAL_ENQUEUE_TOKEN=replace-with-a-strong-random-token

GO_DOWNLOAD_TIMEOUT=30
GO_DOWNLOAD_RETRIES=10
GO_IMAGE_CONCURRENCY=2

# Telegram binaries and private shared session storage are included in the image.
TELEGRAM_ENABLED=true
TELEGRAM_MAX_SOURCE_BYTES=524288000
KOMGA_LIBRARY_MAPPINGS=[]
KOMGA_READONLY_LIBRARY_IDS=[]
